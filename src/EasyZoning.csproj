<Project Sdk="Microsoft.NET.Sdk">
	<!-- File: src/EasyZoning.csproj -->

	<PropertyGroup>
		<Configurations>Debug;Release</Configurations>
		<PublishConfigurationPath>Properties\PublishConfiguration.xml</PublishConfigurationPath>

		<!-- Single source of truth for version number -->
		<Version>1.0.6</Version>
		<AssemblyVersion>$(Version).0</AssemblyVersion>
		<FileVersion>$(Version).0</FileVersion>

		<!-- Assembly Metadata-->
		<AssemblyTitle>EasyZoning</AssemblyTitle>
		<AssemblyName>EasyZoning</AssemblyName>
		<RootNamespace>EasyZoning</RootNamespace>

		<Nullable>enable</Nullable>

		<!-- Master switch for ALL UI steps (npm ci + npm run build) -->
		<RunEZUIBuild Condition="'$(RunEZUIBuild)'==''">true</RunEZUIBuild>

		<!-- Optional timeouts (ms). Exec default is infinite; timeouts prevent "looks stuck forever". -->
		<EZNpmCiTimeoutMs Condition="'$(EZNpmCiTimeoutMs)'==''">450000</EZNpmCiTimeoutMs>
		<EZNpmBuildTimeoutMs Condition="'$(EZNpmBuildTimeoutMs)'==''">300000</EZNpmBuildTimeoutMs>
	</PropertyGroup>

	<!-- CS2 toolchain (sets net48, refs, analyzers, etc.) -->
	<Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.props" />
	<Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.targets" />

	<!-- Explicit refs (toolchain typically handles these; leaving here is fine) -->
	<ItemGroup>
		<Reference Include="Game"><Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Core"><Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Logging"><Private>false</Private>
		</Reference>
		<Reference Include="Colossal.IO.AssetDatabase"><Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Localization"><Private>false</Private>
		</Reference>
		<Reference Include="Colossal.UI"><Private>false</Private>
		</Reference>
		<Reference Include="Colossal.UI.Binding"><Private>false</Private>
		</Reference>

		<Reference Include="UnityEngine.CoreModule"><Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.AudioModule"><Private>false</Private>
		</Reference>
		<Reference Include="Unity.Burst"><Private>false</Private>
		</Reference>
		<Reference Include="Unity.Collections"><Private>false</Private>
		</Reference>
		<Reference Include="Unity.Entities"><Private>false</Private>
		</Reference>
		<Reference Include="Unity.Mathematics"><Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Mathematics"><Private>false</Private>
		</Reference>

		<!-- Required by SettingsUIKeyboardBinding attribute; safe even if unused -->
		<Reference Include="Unity.InputSystem"><Private>false</Private>
		</Reference>
	</ItemGroup>

	<!-- Convenience: make common toolchain files viewable in Properties/ -->
	<ItemGroup>
		<None Include="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.props" Link="Properties\Mod.props" />
		<None Include="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.targets" Link="Properties\Mod.targets" />
	</ItemGroup>

	<!-- Copy ONLY in-game localization files -->
	<ItemGroup>
		<Content Include="lang\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<!-- Show Utilities/ in Solution Explorer but do NOT copy it -->
	<ItemGroup>
		<None Include="Utilities\**\*.*">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
		<Folder Include="Utilities\" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\research\**\*.*">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
		<Folder Include="..\research\" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="Legacy\**\*.cs" />
		<None Include="Legacy\**\*.cs" />
	</ItemGroup>

	<!-- AUTO UPDATE PublishConfiguration ModVersion using CSPROJ Version number
		 remove bom, make EOL=CRLF, and left-align text -->
	<Target Name="UpdatePublishConfigVersion"
			BeforeTargets="Build"
			Condition="'$(Configuration)' == 'Release'
                  AND Exists('$(MSBuildProjectDirectory)\Scripts\Update-PublishConfig.ps1')
                  AND Exists('$(MSBuildProjectDirectory)\$(PublishConfigurationPath)')">

		<Message Text="EZ PublishConfig: syncing ModVersion + normalizing EOL/BOM + left-align blocks..." Importance="high" />

		<Exec Command="&quot;$(SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Scripts\Update-PublishConfig.ps1&quot; -Path &quot;$(MSBuildProjectDirectory)\$(PublishConfigurationPath)&quot; -Version &quot;$(Version)&quot; -Eol crlf -LeftAlignBlocks" />
	</Target>



	<!-- Run npm ci AFTER C# build, only when needed (stamp-based) -->
	<Target Name="NpmInstallIfNeeded"
	        AfterTargets="Build"
	        Condition="'$(RunEZUIBuild)'=='true'
	                  AND Exists('$(ProjectDir)UI\package.json')
	                  AND Exists('$(ProjectDir)UI\package-lock.json')"
	        Inputs="$(ProjectDir)UI\package-lock.json"
	        Outputs="$(ProjectDir)UI\node_modules\.stamp">

		<Message Text="EZ UI: npm ci (first-time or lockfile changed)..." Importance="high" />

		<Exec Command="npm ci"
		      WorkingDirectory="$(ProjectDir)UI"
		      IgnoreExitCode="true"
		      Timeout="$(EZNpmCiTimeoutMs)">
			<Output TaskParameter="ExitCode" PropertyName="NpmCiExit" />
		</Exec>

		<!-- Release: fail hard. Debug: warn only. -->
		<Error Condition="'$(Configuration)'=='Release' AND '$(NpmCiExit)'!='0'"
		       Text="EZ UI: 'npm ci' failed (exit $(NpmCiExit)). Release build aborted." />
		<Warning Condition="'$(Configuration)'=='Debug' AND '$(NpmCiExit)'!='0'"
		         Text="EZ UI: 'npm ci' failed (exit $(NpmCiExit)). Continuing (Debug)." />

		<!-- Stamp written only on success; skip npm ci until lockfile changes again -->
		<WriteLinesToFile Condition="'$(NpmCiExit)' == '0'"
		                  File="$(ProjectDir)UI\node_modules\.stamp"
		                  Lines="ok"
		                  Overwrite="true" />
	</Target>

	<!-- Always run the UI bundle AFTER C# build; runs after NpmInstallIfNeeded -->
	<Target Name="BuildUI"
	        AfterTargets="Build"
	        DependsOnTargets="NpmInstallIfNeeded"
	        Condition="'$(RunEZUIBuild)'=='true' AND Exists('$(ProjectDir)UI\package.json')">

		<Message Text="EZ UI: npm run build ($(Configuration))..." Importance="high" />

		<Exec Command="npm run build"
		      WorkingDirectory="$(ProjectDir)UI"
		      IgnoreExitCode="true"
		      Timeout="$(EZNpmBuildTimeoutMs)">
			<Output TaskParameter="ExitCode" PropertyName="NpmBuildExit" />
		</Exec>

		<!-- Release: fail hard. Debug: warn only. -->
		<Error Condition="'$(Configuration)'=='Release' AND '$(NpmBuildExit)'!='0'"
		       Text="EZ UI: 'npm run build' failed (exit $(NpmBuildExit)). Release build aborted." />
		<Warning Condition="'$(Configuration)'=='Debug' AND '$(NpmBuildExit)'!='0'"
		         Text="EZ UI: 'npm run build' failed (exit $(NpmBuildExit)). Continuing (Debug)." />
	</Target>
</Project>
